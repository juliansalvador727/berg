{
  "name": "berg-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "vite --mode e2e --host localhost --port 5173",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json --noEmit"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "maplibre-gl": "^5.0.0",
    "pmtiles": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
