# R2 (S3-compatible API). Never commit the filled-in .env.
# Unset any of these and the pipeline stages locally, skipping the upload — fine for dev.
# CI sets BERG_REQUIRE_R2=1 so that a dropped secret fails instead of publishing nothing.
R2_ACCOUNT_ID=
R2_BUCKET=berg
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Local DuckDB. A month of raw CSV does not fit in RAM — the spill directory is not optional.
BERG_DUCKDB_PATH=data/berg.duckdb
BERG_DUCKDB_MEMORY_LIMIT=8GB
BERG_DUCKDB_TEMP_DIR=data/tmp
