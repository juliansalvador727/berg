{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://berg-rail-observer.pages.dev",
          "http://localhost:5173"
        ],
        "methods": ["GET", "HEAD"],
        "headers": ["range", "content-type"]
      },
      "exposeHeaders": ["content-length", "content-range", "etag"],
      "maxAgeSeconds": 3600
    }
  ]
}
